# Адрес и публикуемый ключ проекта Supabase.
# Публикуемый ключ безопасен для браузера: доступ ограничивают политики RLS.
# Реальные значения лежат в .env, который НЕ коммитится.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Только для сид-скрипта, в браузер НИКОГДА не попадает.
# Берётся в Supabase: Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
